<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Runiq.AI.Memory.PostgreSql</PackageId>
    <Version>1.0.0</Version>
    <Description>Durable PostgreSQL conversation and message persistence for Runiq Memory.</Description>
    <PackageTags>ai;memory;postgresql;runiq</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runiq.AI.Memory/Runiq.AI.Memory.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="../../assets/nuget/runiq-icon.png" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>
</Project>
